# Production build-time config for the Next.js frontend.
# Loaded automatically by `next build` (production mode) on Vercel and anywhere
# else. NEXT_PUBLIC_API_URL is inlined into the browser bundle so the deployed
# frontend calls the deployed backend. Not a secret (a public API base URL), so
# committing it is fine. Local `next dev` does NOT load this file, so local
# development still defaults to http://localhost:8000.
NEXT_PUBLIC_API_URL=https://oiltrace-4wgn.onrender.com
